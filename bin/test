#!/usr/bin/env bash
# bin/test - lance les suites de toutes les sous-apps.
#
# Source de verite : openspec/changes/add-tech-stack/tasks.md section 2.1
# Mise à jour replace-web-with-tui : `apps/web` retiré au profit de la
# TUI Go `apps/tui` ; chaque scanner spécialisé sous `apps/scanner-<kind>`
# (squelette unifié dans `apps/scanner` en attendant le split §3.1).

set -euo pipefail

cd "$(dirname "$0")/.."

failed=0

run_suite() {
  local label=$1
  local dir=$2
  local cmd=$3

  if [[ ! -d "$dir" || -z "$(ls -A "$dir" 2>/dev/null)" ]]; then
    echo "[skip] $label ($dir empty - bootstrap pending)"
    return 0
  fi

  echo "==> $label"
  if ! (cd "$dir" && eval "$cmd"); then
    echo "[fail] $label"
    failed=1
  fi
}

run_suite "apps/api     (rspec)" "apps/api"     "[[ -f Gemfile.lock ]] && bundle exec rspec || echo '[skip] apps/api: Gemfile.lock missing'"
run_suite "apps/scanner  (go)"   "apps/scanner" "[[ -f go.mod ]] && go test ./... || echo '[skip] apps/scanner: go.mod missing'"
run_suite "apps/tui      (go)"   "apps/tui"     "[[ -f go.mod ]] && go test ./... || echo '[skip] apps/tui: go.mod missing'"

if (( failed != 0 )); then
  exit 1
fi

echo "==> all suites green"
