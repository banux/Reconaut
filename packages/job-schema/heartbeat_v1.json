{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reconaut.dev/schemas/heartbeat_v1.json",
  "title": "HeartbeatV1",
  "description": "Battement de coeur emis par un worker Go pour signaler son etat. Cf. openspec/changes/add-tech-stack/specs/architecture/spec.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "worker_id",
    "emitted_at",
    "inflight_jobs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "inflight_jobs": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "string",
      "description": "SemVer du binaire scanner-worker."
    }
  }
}
