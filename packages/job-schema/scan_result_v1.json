{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reconaut.dev/schemas/scan_result_v1.json",
  "title": "ScanResultV1",
  "description": "Resultat de scan emis par un worker Go a destination de Rails. Cf. openspec/changes/add-tech-stack/specs/architecture/spec.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "idempotency_key",
    "target",
    "status",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "description": "Reference au good_jobs.id qui a declenche ce resultat."
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "description": "Reprise telle quelle de la cle d'idempotence du ScanJobV1 ; permet la deduplication cote ingestion Rails."
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["ip", "cidr", "domain", "host"]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failure", "skipped_out_of_scope"]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "findings": {
      "type": "array",
      "description": "Observations brutes. Le typage strict par finding viendra avec le change scan-engine.",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "type": "object",
      "description": "Present si status in {failure, partial}. Champ libre pour la v1.",
      "additionalProperties": true
    }
  }
}
