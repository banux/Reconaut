source "https://rubygems.org"

gem "rails", "~> 8.1.3"
gem "pg", "~> 1.5"
gem "puma", ">= 5.0"

# File de jobs : GoodJob (adapter ActiveJob backe par Postgres).
# Cf. openspec/project.md et openspec/changes/add-tech-stack/specs/architecture/spec.md
# Pas de broker externe en v1.
gem "good_job", "~> 4.0"

# Validation des messages de job (ScanJobV1, ScanResultV1, Heartbeat).
# Cf. add-tech-stack section 3.1.
gem "json-schema", "~> 5.0"

# Hashing Argon2id pour les mots de passe et les cles API.
# Cf. init-reconaut-platform section 7.2 (auth local-first).
gem "argon2", "~> 2.3"

gem "tzinfo-data", platforms: %i[windows jruby]
gem "bootsnap", require: false

group :development, :test do
  gem "debug", platforms: %i[mri windows], require: "debug/prelude"
  gem "bundler-audit", require: false

  # Suite de tests : RSpec (cf. add-tech-stack tasks 2.1).
  gem "rspec-rails", "~> 8.0"

  # Audit de licence des dependances : interdit en CI toute gem dont la
  # licence n'est pas compatible AGPL-3.0 (cf. add-graph-retrieval 9.1).
  gem "license_finder", "~> 7.0", require: false
end
